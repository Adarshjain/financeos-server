# Example environment configuration for Fluent Bit
# Copy or reference this in systemd drop-in /etc/systemd/system/fluent-bit.service.d/override.conf:
#
# [Service]
# EnvironmentFile=/etc/fluent-bit/fluent-bit.env
#
# Do NOT place real tokens in checked-in files.

GRAFANA_LOKI_HOST=logs-prod-us-central1.grafana.net
GRAFANA_LOKI_USER=123456

# Note: Prometheus instance ID is DIFFERENT from Loki instance ID. The Cloud Access Policy token is shared.
GRAFANA_PROM_HOST=prometheus-prod-10-prod-us-central-0.grafana.net
GRAFANA_PROM_USER=654321

GRAFANA_CLOUD_TOKEN=your_grafana_cloud_access_policy_token_here
