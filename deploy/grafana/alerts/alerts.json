{
  "folder": "FinanceOS",
  "groups": [
    {
      "name": "FinanceOS Server Alerts",
      "folder": "FinanceOS",
      "interval": "5m",
      "rules": [
        {
          "uid": "financeos-alert-error-burst",
          "title": "ERROR burst",
          "condition": "A",
          "for": "0m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "The FinanceOS server is logging a lot of errors — more than 5 in the last 15 minutes. Something is failing repeatedly.",
            "description": "Open Grafana → Service Health dashboard → ERROR logs panel to see which feature is breaking and grab the errorId."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_LOKI}",
              "model": {
                "expr": "sum(count_over_time({service=\"financeos-server\", level=\"ERROR\"}[15m])) > 5",
                "queryType": "instant"
              },
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-llm-chain-exhausted",
          "title": "LLM chain exhausted",
          "condition": "A",
          "for": "0m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "AI features are failing — a request tried every AI provider in the failover chain and all of them errored.",
            "description": "Usually a rate limit (429) or a bad/expired API key (401). Open Grafana → LLM Providers dashboard to see which provider failed and why."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_LOKI}",
              "model": {
                "expr": "sum(count_over_time({service=\"financeos-server\"} | json | event=\"llm.chain.exhausted\" [15m])) > 0",
                "queryType": "instant"
              },
              "relativeTimeRange": {
                "from": 1200,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-job-failed",
          "title": "Job failed",
          "condition": "A",
          "for": "0m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "The background job \"{{ $labels.jobName }}\" crashed, so its work (syncing or refreshing data) did not complete.",
            "description": "Open Grafana → Pipelines dashboard → job outcomes, and check the server logs around this time for the error."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_LOKI}",
              "model": {
                "expr": "sum by (jobName) (count_over_time({service=\"financeos-server\"} | json | event=\"job.failed\" [30m])) > 0",
                "queryType": "instant"
              },
              "relativeTimeRange": {
                "from": 1800,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-heap-pressure",
          "title": "Heap pressure",
          "condition": "A",
          "for": "10m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "The FinanceOS server app is almost out of memory (above 90% for 10+ minutes) and could crash soon.",
            "description": "If it crashes it will restart and drop whatever it was doing. Check Grafana memory panels for what is eating memory; a restart at a quiet moment clears it short-term."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "sum(jvm_memory_used_bytes{service=\"financeos-server\", area=\"heap\"}) / sum(jvm_memory_max_bytes{service=\"financeos-server\", area=\"heap\"} > 0) > 0.9",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-host-memory-low",
          "title": "Host memory low",
          "condition": "A",
          "for": "10m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "The server VM itself is nearly out of RAM (under 80MB free) — Linux may start killing processes, including the app.",
            "description": "SSH into the OCI VM and check what is using memory (`free -m`, `top`). If there is no swap, run deploy/add-swap.sh."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "node_memory_MemAvailable_bytes < 83886080",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-disk-low",
          "title": "Disk low",
          "condition": "A",
          "for": "15m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "The server's disk is almost full — less than 15% space left. If it fills up completely, the app and logging stop working.",
            "description": "SSH into the VM and free space: `df -h` to confirm, then clean old logs/files (e.g. `du -sh /var/log/*`)."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} < 0.15",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-db-pool-starved",
          "title": "DB pool starved",
          "condition": "A",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Requests have been stuck waiting for a database connection for 5+ minutes — the app will feel slow or frozen.",
            "description": "Usually a slow query hogging connections. Check Grafana → Pipelines dashboard for slow SQL; restart the app if it does not clear."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "hikaricp_connections_pending{service=\"financeos-server\"} > 0",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-gmail-ingest-stalled",
          "title": "Gmail ingest stalled",
          "condition": "A",
          "for": "30m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Gmail sync hasn't succeeded in over 15 hours — new transactions from email are NOT coming in.",
            "description": "Check Grafana → Pipelines dashboard. Most common causes: the Gmail connection needs re-authorizing, or Gmail API quota ran out."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "(time() - financeos_job_last_success_timestamp_seconds{job=\"gmail-ingest\"}) > 54000",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-price-refresh-stalled",
          "title": "Price refresh stalled",
          "condition": "A",
          "for": "30m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Investment prices haven't refreshed in over 26 hours — portfolio values shown in the app are stale.",
            "description": "Check Grafana → Pipelines dashboard, and whether the price sources (Yahoo/AMFI) are reachable from the server."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "(time() - financeos_job_last_success_timestamp_seconds{job=\"price-refresh\"}) > 93600",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-http-5xx-ratio",
          "title": "5xx burst",
          "condition": "A",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Users are hitting server errors — more than 3 requests returned a 500-type error in the last 15 minutes.",
            "description": "Open Grafana → Service Health dashboard and the ERROR logs panel to see which endpoint is failing and why."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "sum(increase(http_server_requests_seconds_count{service=\"financeos-server\", status=~\"5..\"}[15m])) > 3",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-http-latency",
          "title": "Latency high",
          "condition": "A",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "The app is responding slowly — slower requests are now taking over 2 seconds, and it has stayed that way for 15+ minutes.",
            "description": "Check Grafana for slow SQL queries, database pool pressure, and slow external APIs (Gmail, price feeds)."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_PROM}",
              "model": {
                "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"financeos-server\"}[15m]))) > 2) and on() (sum(rate(http_server_requests_seconds_count{service=\"financeos-server\"}[15m])) > 0.02)",
                "instant": true,
                "range": false
              },
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-oauth-failures",
          "title": "OAuth failures",
          "condition": "A",
          "for": "0m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "People can't sign in with Google or connect Gmail — more than 3 login/connect attempts failed in the last 10 minutes.",
            "description": "Check the Google OAuth settings (redirect URIs, consent screen) and look for an app.config.suspect line in the server startup logs."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_LOKI}",
              "model": {
                "expr": "sum(count_over_time({service=\"financeos-server\"} | json | event=~\"oauth\\\\..*\\\\.callback\\\\.failed\" [10m])) > 3",
                "queryType": "instant"
              },
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-config-suspect-at-boot",
          "title": "Config suspect at boot",
          "condition": "A",
          "for": "0m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "The server started up with a configuration that looks wrong (e.g. a bad OAuth redirect URL or cookie origin) — sign-in or Gmail connect may be broken.",
            "description": "Check the server startup logs for the app.config.suspect line; it names the exact setting that looks off."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_LOKI}",
              "model": {
                "expr": "sum(count_over_time({service=\"financeos-server\"} | json | event=\"app.config.suspect\" [1h])) > 0",
                "queryType": "instant"
              },
              "relativeTimeRange": {
                "from": 3900,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        },
        {
          "uid": "financeos-alert-client-action-failures",
          "title": "Client action failures",
          "condition": "A",
          "for": "0m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Actions in the web app are failing for users — more than 5 saves/clicks errored in the last 10 minutes.",
            "description": "Open Grafana → Client Health dashboard to see which action is failing and its errorId."
          },
          "notification_settings": {
            "receiver": "slack-financeos"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "${DS_LOKI}",
              "model": {
                "expr": "sum(count_over_time({service=\"financeos-client\", env=\"prod\"} | json | event=\"client.action.failed\" [10m])) > 5",
                "queryType": "instant"
              },
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              }
            }
          ],
          "execErrState": "Alerting",
          "noDataState": "OK"
        }
      ]
    }
  ]
}
