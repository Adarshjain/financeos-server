{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{service=\"financeos-client\", env=\"$env\"} | json | unwrap durationMs",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Client Health Status",
      "type": "stat"
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["sum"]
        }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum(rate({service=\"financeos-client\", env=\"$env\"} | json | event=\"client.coldstart\" [5m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Coldstart Frequency",
      "type": "stat"
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "descending" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (route, status) (rate({service=\"financeos-client\", env=\"$env\"} | json | event=\"client.request\" [1m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Request Rate & Status Breakdown by Route",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "descending" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service=\"financeos-client\", env=\"$env\"} | json | event=\"client.request\" | unwrap durationMs [5m]) by (route)",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Client-Side P95 Latency by Route (ms)",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "descending" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service=\"financeos-client\", env=\"$env\"} | json | event=\"client.api.call\" | unwrap durationMs [5m])",
          "legendFormat": "P95 API Latency",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum(rate({service=\"financeos-client\", env=\"$env\"} | json | event=\"client.api.call\", status!~\"2..\" [5m])) / sum(rate({service=\"financeos-client\", env=\"$env\"} | json | event=\"client.api.call\" [5m])) * 100",
          "legendFormat": "API Error Rate (%)",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Client -> API Call P95 Latency & Error Rate (Vercel -> OCI Hop)",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "descending" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (code) (rate({service=\"financeos-client\", env=\"$env\"} | json | event=\"client.action.failed\" [5m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Client Action Failures by Error Code",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 7,
      "options": {
        "frameIndex": 0,
        "showHeader": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{service=\"financeos-client\", env=\"$env\"} | json | event=\"client.action.failed\" | errorId!=\"\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Relayed Java errorIds (Cross-Tier Exception Correlation)",
      "type": "table"
    },
    {
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{service=\"financeos-client\", env=\"$env\", level=\"ERROR\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "FinanceOS Client Error Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["financeos", "client", "vercel"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "hide": 0,
        "label": "Environment",
        "name": "env",
        "options": [
          { "selected": true, "text": "prod", "value": "prod" },
          { "selected": false, "text": "dev", "value": "dev" }
        ],
        "query": "prod,dev",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FinanceOS / Client Health & Vercel Observability",
  "uid": "financeos-client-health",
  "version": 1
}
