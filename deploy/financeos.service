# Revised version of the unit installed at /etc/systemd/system/financeos.service.
# Observability updates:
# - Capped heap to -Xmx512m for 952 MiB RAM boundary.
# - Added -XX:+ExitOnOutOfMemoryError so systemd cleanly restarts wedged JVM on OOM.
# - Added -Xlog:gc* GC logging for pause/heap monitoring.
#
# To apply:
#   sudo cp financeos.service /etc/systemd/system/financeos.service
#   sudo systemctl daemon-reload && sudo systemctl restart financeos

[Unit]
Description=FinanceOS Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/financeos-server
EnvironmentFile=/home/ubuntu/financeos-server/.env

# Oracle wallet configuration
Environment="TNS_ADMIN=/home/ubuntu/financeos-server/wallet"
ExecStart=/usr/bin/java -Xmx512m \
  -XX:+ExitOnOutOfMemoryError \
  -Xlog:gc*:file=/home/ubuntu/financeos-server/logs/gc.log:time,uptime:filecount=3,filesize=5M \
  -Djava.net.preferIPv4Stack=true \
  -Djava.net.preferIPv6Addresses=false \
  -Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts \
  -Djavax.net.ssl.trustStorePassword=changeit \
  -Djavax.net.ssl.trustStoreType=pkcs12 \
  -Doracle.net.tns_admin=/home/ubuntu/financeos-server/wallet \
  -jar /home/ubuntu/financeos-server/target/backend-1.0.0.jar --spring.profiles.active=prod

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=financeos

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
